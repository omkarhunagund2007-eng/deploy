{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{scratch/**,frontend/**,instance/**,venv/**,.env,__pycache__/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}
